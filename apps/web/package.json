{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "workledger's local UI: React 19 + Vite + Tailwind, hash-routed, installable as a PWA, every asset bundled.",
  "license": "MIT",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "clean": "rm -rf dist .tsbuildinfo",
    "dev": "vite",
    "preview": "vite preview",
    "lighthouse": "node scripts/lighthouse.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.13",
    "@workledger/api-client": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "chrome-launcher": "^1.2.0",
    "@workledger/core": "workspace:*",
    "@workledger/tokens": "workspace:*",
    "jsdom": "^27.0.0",
    "lighthouse": "^11.7.1",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^4.1.11"
  }
}
