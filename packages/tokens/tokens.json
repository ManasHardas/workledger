{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "workledger design tokens (W3C design-tokens format). Single source of truth for color, spacing, radius, type and the one shadow; the palette and scale are docs/design/direction.md, written in code rather than Figma (P7). Synced from Figma variables when a file exists (design spec §14.1). Nothing in apps/web hardcodes a value — the Tailwind preset and the CSS custom properties are both generated from this file by scripts/build-preset.mjs.",
  "color": {
    "$type": "color",
    "$description": "Semantic roles, one value per theme. `light` is the default; `dark` is applied under prefers-color-scheme: dark. Dark is the designed-first theme (direction.md §Tokens): near-black surfaces separated by hairlines, one accent hue reserved for selection, focus and links, and status hues reserved for status. Values are opaque hex rather than the direction's rgba() so a Figma round-trip is lossless; each is the direction's alpha composited on the surface it sits on.",
    "light": {
      "background": {
        "$value": "#f2f3f5"
      },
      "foreground": {
        "$value": "#202123"
      },
      "muted": {
        "$value": "#eff0f2"
      },
      "muted-foreground": {
        "$value": "#666768"
      },
      "card": {
        "$value": "#ffffff"
      },
      "card-foreground": {
        "$value": "#202123"
      },
      "popover": {
        "$value": "#ffffff"
      },
      "popover-foreground": {
        "$value": "#202123"
      },
      "border": {
        "$value": "#e4e5e8"
      },
      "input": {
        "$value": "#d5d6da"
      },
      "ring": {
        "$value": "#4f5bd5"
      },
      "primary": {
        "$value": "#4f5bd5"
      },
      "primary-foreground": {
        "$value": "#ffffff"
      },
      "secondary": {
        "$value": "#eff0f2"
      },
      "secondary-foreground": {
        "$value": "#202123"
      },
      "accent": {
        "$value": "#eceefb"
      },
      "accent-foreground": {
        "$value": "#3b45ae"
      },
      "destructive": {
        "$value": "#b3372e"
      },
      "destructive-foreground": {
        "$value": "#ffffff"
      },
      "warning": {
        "$value": "#8a5a12"
      },
      "warning-foreground": {
        "$value": "#ffffff"
      },
      "success": {
        "$value": "#1f7a52"
      },
      "success-foreground": {
        "$value": "#ffffff"
      },
      "surface": {
        "$value": "#ffffff"
      },
      "raised": {
        "$value": "#ffffff"
      },
      "hairline": {
        "$value": "#e4e5e8"
      },
      "subtle-foreground": {
        "$value": "#8e8f90"
      },
      "selected": {
        "$value": "#eef0fc"
      },
      "overlay": {
        "$value": "#0d0e10"
      }
    },
    "dark": {
      "background": {
        "$value": "#0d0e10"
      },
      "foreground": {
        "$value": "#ebeced"
      },
      "muted": {
        "$value": "#1a1b1f"
      },
      "muted-foreground": {
        "$value": "#a3a4a7"
      },
      "card": {
        "$value": "#141517"
      },
      "card-foreground": {
        "$value": "#ebeced"
      },
      "popover": {
        "$value": "#1a1b1f"
      },
      "popover-foreground": {
        "$value": "#ebeced"
      },
      "border": {
        "$value": "#232427"
      },
      "input": {
        "$value": "#2b2c30"
      },
      "ring": {
        "$value": "#6e79f5"
      },
      "primary": {
        "$value": "#6e79f5"
      },
      "primary-foreground": {
        "$value": "#0b0c10"
      },
      "secondary": {
        "$value": "#1a1b1f"
      },
      "secondary-foreground": {
        "$value": "#ebeced"
      },
      "accent": {
        "$value": "#22243a"
      },
      "accent-foreground": {
        "$value": "#aeb5ff"
      },
      "destructive": {
        "$value": "#f0555c"
      },
      "destructive-foreground": {
        "$value": "#1a0b0d"
      },
      "warning": {
        "$value": "#e0a64a"
      },
      "warning-foreground": {
        "$value": "#1c1305"
      },
      "success": {
        "$value": "#48c08c"
      },
      "success-foreground": {
        "$value": "#06180f"
      },
      "surface": {
        "$value": "#141517"
      },
      "raised": {
        "$value": "#1a1b1f"
      },
      "hairline": {
        "$value": "#232427"
      },
      "subtle-foreground": {
        "$value": "#727376"
      },
      "selected": {
        "$value": "#1e2036"
      },
      "overlay": {
        "$value": "#000000"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "$description": "4px base step on an 8px rhythm (direction.md §Density), plus the five layout constants the shell is measured in: the 240px nav, the 380px panel, the 760px reading column, the 32px list row and the 28px nav row.",
    "0": {
      "$value": "0rem"
    },
    "px": {
      "$value": "0.0625rem"
    },
    "1": {
      "$value": "0.25rem"
    },
    "2": {
      "$value": "0.5rem"
    },
    "3": {
      "$value": "0.75rem"
    },
    "4": {
      "$value": "1rem"
    },
    "5": {
      "$value": "1.25rem"
    },
    "6": {
      "$value": "1.5rem"
    },
    "8": {
      "$value": "2rem"
    },
    "10": {
      "$value": "2.5rem"
    },
    "12": {
      "$value": "3rem"
    },
    "16": {
      "$value": "4rem"
    },
    "inset": {
      "$value": "0.75rem"
    },
    "row-nav": {
      "$value": "1.75rem"
    },
    "row": {
      "$value": "2rem"
    },
    "nav": {
      "$value": "15rem"
    },
    "panel": {
      "$value": "23.75rem"
    },
    "reading": {
      "$value": "47.5rem"
    }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Two radii carry the design (direction.md §Tokens): `md` is 6px, every control; `lg` is 10px, the floating panel. The rest are kept for the primitives that already name them.",
    "none": {
      "$value": "0rem"
    },
    "sm": {
      "$value": "0.25rem"
    },
    "md": {
      "$value": "0.375rem"
    },
    "lg": {
      "$value": "0.625rem"
    },
    "xl": {
      "$value": "0.75rem"
    },
    "full": {
      "$value": "9999rem"
    }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "One shadow in the whole app, on the floating right panel only (direction.md §Tokens).",
    "panel": {
      "$value": "0 8px 28px -6px #0000004d"
    }
  },
  "type": {
    "$description": "Type scale and the two families. No web font is ever fetched (design spec §14), so a family is a stack of faces the host already has. Sizes are direction.md's four steps — 12 meta, 13 base, 15 section heading, 20 page title — with `sm` and `base` both 13 so a body class means the same thing whichever the component reached for.",
    "size": {
      "$type": "dimension",
      "xs": {
        "$value": "0.75rem"
      },
      "sm": {
        "$value": "0.8125rem"
      },
      "base": {
        "$value": "0.8125rem"
      },
      "lg": {
        "$value": "0.9375rem"
      },
      "xl": {
        "$value": "1.25rem"
      },
      "2xl": {
        "$value": "1.5rem"
      }
    },
    "leading": {
      "$type": "dimension",
      "$description": "Line-height 1.45 (direction.md), written as a length so a Figma round-trip stays lossless: 19px on the 13px base, 16px tight, 29px on the 20px title.",
      "tight": {
        "$value": "1rem"
      },
      "body": {
        "$value": "1.1875rem"
      },
      "title": {
        "$value": "1.8125rem"
      }
    },
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": "ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
      },
      "mono": {
        "$value": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
      }
    }
  }
}
