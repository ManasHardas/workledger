{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "workledger design tokens (W3C design-tokens format). Single source of truth for color, spacing, radius and type; synced from Figma variables once designs exist (design spec §14.1). Nothing in apps/web hardcodes a value — the Tailwind preset and the CSS custom properties are both generated from this file by scripts/build-preset.mjs.",
  "color": {
    "$type": "color",
    "$description": "Semantic roles, one value per theme. `light` is the default; `dark` is applied under prefers-color-scheme: dark.",
    "light": {
      "background": {
        "$value": "#fbfbfa"
      },
      "foreground": {
        "$value": "#1c1b19"
      },
      "muted": {
        "$value": "#f0efec"
      },
      "muted-foreground": {
        "$value": "#6b6a65"
      },
      "card": {
        "$value": "#ffffff"
      },
      "card-foreground": {
        "$value": "#1c1b19"
      },
      "popover": {
        "$value": "#ffffff"
      },
      "popover-foreground": {
        "$value": "#1c1b19"
      },
      "border": {
        "$value": "#e2e0db"
      },
      "input": {
        "$value": "#e2e0db"
      },
      "ring": {
        "$value": "#3d7a5a"
      },
      "primary": {
        "$value": "#2f6b4f"
      },
      "primary-foreground": {
        "$value": "#f6faf7"
      },
      "secondary": {
        "$value": "#f0efec"
      },
      "secondary-foreground": {
        "$value": "#2b2a27"
      },
      "accent": {
        "$value": "#e8f0ea"
      },
      "accent-foreground": {
        "$value": "#24503b"
      },
      "destructive": {
        "$value": "#a3352b"
      },
      "destructive-foreground": {
        "$value": "#fdf6f5"
      },
      "warning": {
        "$value": "#8a5a12"
      },
      "warning-foreground": {
        "$value": "#fdf9f2"
      },
      "success": {
        "$value": "#2f6b4f"
      },
      "success-foreground": {
        "$value": "#f6faf7"
      }
    },
    "dark": {
      "background": {
        "$value": "#151614"
      },
      "foreground": {
        "$value": "#eceae5"
      },
      "muted": {
        "$value": "#232522"
      },
      "muted-foreground": {
        "$value": "#9d9b94"
      },
      "card": {
        "$value": "#1c1e1b"
      },
      "card-foreground": {
        "$value": "#eceae5"
      },
      "popover": {
        "$value": "#1c1e1b"
      },
      "popover-foreground": {
        "$value": "#eceae5"
      },
      "border": {
        "$value": "#32352f"
      },
      "input": {
        "$value": "#32352f"
      },
      "ring": {
        "$value": "#6fb894"
      },
      "primary": {
        "$value": "#6fb894"
      },
      "primary-foreground": {
        "$value": "#10231a"
      },
      "secondary": {
        "$value": "#232522"
      },
      "secondary-foreground": {
        "$value": "#eceae5"
      },
      "accent": {
        "$value": "#233028"
      },
      "accent-foreground": {
        "$value": "#b9e2cc"
      },
      "destructive": {
        "$value": "#e0705f"
      },
      "destructive-foreground": {
        "$value": "#26100d"
      },
      "warning": {
        "$value": "#d9a441"
      },
      "warning-foreground": {
        "$value": "#241a08"
      },
      "success": {
        "$value": "#6fb894"
      },
      "success-foreground": {
        "$value": "#10231a"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "$description": "4px base step; the scale apps/web lays out on.",
    "0": {
      "$value": "0rem"
    },
    "px": {
      "$value": "0.0625rem"
    },
    "1": {
      "$value": "0.25rem"
    },
    "2": {
      "$value": "0.5rem"
    },
    "3": {
      "$value": "0.75rem"
    },
    "4": {
      "$value": "1rem"
    },
    "5": {
      "$value": "1.25rem"
    },
    "6": {
      "$value": "1.5rem"
    },
    "8": {
      "$value": "2rem"
    },
    "10": {
      "$value": "2.5rem"
    },
    "12": {
      "$value": "3rem"
    },
    "16": {
      "$value": "4rem"
    }
  },
  "radius": {
    "$type": "dimension",
    "none": {
      "$value": "0rem"
    },
    "sm": {
      "$value": "0.25rem"
    },
    "md": {
      "$value": "0.375rem"
    },
    "lg": {
      "$value": "0.5rem"
    },
    "xl": {
      "$value": "0.75rem"
    },
    "full": {
      "$value": "9999rem"
    }
  },
  "type": {
    "$description": "Type scale and the two families. No web font is ever fetched (design spec §14), so a family is a stack of faces the host already has.",
    "size": {
      "$type": "dimension",
      "xs": {
        "$value": "0.75rem"
      },
      "sm": {
        "$value": "0.8125rem"
      },
      "base": {
        "$value": "0.9375rem"
      },
      "lg": {
        "$value": "1.125rem"
      },
      "xl": {
        "$value": "1.375rem"
      },
      "2xl": {
        "$value": "1.75rem"
      }
    },
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": "ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
      },
      "mono": {
        "$value": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
      }
    }
  }
}
