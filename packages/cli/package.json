{
  "name": "workledger",
  "version": "0.2.0",
  "type": "module",
  "description": "Local observer for coding-agent sessions: checkpoint digests, ledger, backlog.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ManasHardas/workledger.git",
    "directory": "packages/cli"
  },
  "bin": {
    "workledger": "./bin/workledger"
  },
  "files": ["dist/main.js", "dist/server.js", "dist/migrations", "dist/web", "bin"],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b && node ../../scripts/bundle-cli.mjs",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "prepack": "node ../../scripts/bundle-cli.mjs strip-manifest",
    "postpack": "node ../../scripts/bundle-cli.mjs restore-manifest"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22",
    "@workledger/core": "workspace:*",
    "@workledger/server": "workspace:*",
    "commander": "^15.0.0"
  }
}
