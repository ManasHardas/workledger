#!/usr/bin/env node
// Extensionless bin shim: the module type of this file is host-determined, so it uses a
// dynamic import (valid under both ESM and CJS) to reach the compiled ESM entry point.
import("../dist/main.js")
  .then((main) => {
    main.run();
  })
  .catch((error) => {
    console.error(error);
    process.exit(1);
  });
